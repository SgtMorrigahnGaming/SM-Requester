# Production image: compiles TypeScript, then ships only the compiled JS +
# production dependencies. No source bind-mounting, no tsx watch — this is
# meant to be built once per release and just run.
FROM node:20-alpine AS build
WORKDIR /app
COPY package.json ./
RUN npm install
COPY . .
RUN npm run build

FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package.json ./
RUN npm install --omit=dev
COPY --from=build /app/dist ./dist

EXPOSE 8081
CMD ["node", "dist/index.js"]
