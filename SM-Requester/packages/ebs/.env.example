# --- Server ---
PORT=8081

# --- Twitch (Developer Console: dev.twitch.tv/console) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Extension-specific secret used to verify viewer JWTs (base64, from the Extension's
# "Secrets" tab in the dev console)
TWITCH_EXTENSION_SECRET=
TWITCH_EXTENSION_CLIENT_ID=
# Where Twitch EventSub webhooks will reach this server (must be public HTTPS in prod;
# use a tunnel like ngrok/cloudflared for local dev)
EVENTSUB_CALLBACK_URL=https://your-public-url/eventsub
EVENTSUB_SECRET=change-me-to-a-random-string

# --- Spotify (developer.spotify.com/dashboard) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8081/auth/spotify/callback

# --- Database ---
DATABASE_URL=file:./dev.db
